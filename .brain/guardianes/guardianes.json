{
  "_ayuda": "Ajustes neutros de los guardianes de Cerebro Vivo (repo del arnés). Cada proyecto edita solo su copia.",
  "idioma": "es",
  "registro": ".brain/decisions.log",
  "pendientes": ".brain/pendientes.md",
  "tope_pendientes_bytes": 8192,
  "cierre_por_bloque": true,
  "cierre_bloque_max_ediciones": 15,
  "modo_ligero_activo": true,
  "modo_ligero": {
    "max_archivos": 2,
