  },
  "claude_md": "CLAUDE.md",
  "indices_entrada": [
    "CLAUDE.md"
  ],
  "tope_claude_md_bytes": 5120,
  "ignorar_cambios": [
    ".brain/*",
    ".claude/*",
    "*.migrado",
    "__pycache__/*",
    "*.pyc",
    "*.bak*"
  ],
  "no_avisar_commit": ["*.migrado", "__pycache__/*", "*.pyc", "*.bak*", ".brain/decisions.log", ".brain/traspaso.md", ".brain/traspaso-completo.md", ".brain/lecciones/*", ".brain/archive/traspasos/*", ".brain/guardianes/*_estado.json"],
  "plugins_requeridos": [],
  "alerta_contexto_tokens": 300000,
  "longitud_activa": true,
  "chat_nuevo_auto": true,
  "modo_fabrica": false,
  "lecciones_activas": true,
  "lecciones_vigiladas": {},
  "hitos_max_archivos": 5,
  "hitos_errores_min": 1,
  "traspaso_corto_max": 2500,
  "longitud_aviso_tokens": 200000,
  "longitud_repetir_tokens": 100000,
  "revision_indices_activa": true,
  "revision_indices_dias": 90,
  "revision_indices_seccion_bytes": 6000,
  "revision_indices_aviso_dias": 60,
  "revision_indices_aviso_porcentaje": 80,
  "revision_indices_ignorar": [],
  "poda_activa": true,
  "poda_excluir": [],
  "tope_registros_bytes": 61440,
  "tope_archivo_memoria_bytes": 8192,
  "aviso_arnes_activo": true,
  "archivos_gordos_activo": true,
  "archivos_gordos_aviso_porcentaje": 80,
  "archivos_gordos_ignorar": [],
  "base_datos_activo": false,
  "base_datos": {
    "ruta": "",
    "copias_carpeta": "copias_bd",
    "copias_max": 5,
    "triggers": [],
    "esquema_desde": ""
  },
  "secretos_activo": true,
  "secretos": {
    "dias_aviso_historial": 30,
    "archivos_secretos": [
      ".env"
    ],
    "permitidos": [],
    "patrones": [
      {
        "nombre": "token de bot de Discord",
        "confianza": "alta",
        "regex": "(?<![A-Za-z0-9+/_-])[MN][A-Za-z0-9]{23,25}\\.[A-Za-z0-9_-]{6}\\.[A-Za-z0-9_-]{27,}"
      },
      {
        "nombre": "clave de Google/Gemini",
        "confianza": "alta",
        "regex": "(?<![A-Za-z0-9+/_-])AIza[0-9A-Za-z_-]{35}"
      },
      {
        "nombre": "token de GitHub",
        "confianza": "alta",
        "regex": "(?<![A-Za-z0-9+/_-])gh[pousr]_[A-Za-z0-9]{36,}"
      },
      {
        "nombre": "clave sk-",
        "confianza": "alta",
        "regex": "(?<![A-Za-z0-9+/_-])sk[-_](?:live_|proj-)?[A-Za-z0-9_-]{24,}"
      },
      {
        "nombre": "token de Slack",
        "confianza": "alta",
        "regex": "(?<![A-Za-z0-9+/_-])xox[bpas]-[A-Za-z0-9-]{10,}"
      },
      {
        "nombre": "llave privada",
        "confianza": "alta",
        "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
      },
      {
        "nombre": "webhook de Discord",
        "confianza": "alta",
        "regex": "https://(?:discord|discordapp)\\.com/api/webhooks/\\d{17,20}/[A-Za-z0-9_-]{60,}"
      },
      {
        "nombre": "asignación sospechosa",
        "confianza": "baja",
        "regex": "(?i)\\b\\w*(?:secret|token|passw(?:or)?d|api_?key)\\w*\\s*[:=]\\s*[\"']([A-Za-z0-9_\\-/+=]{24,})[\"']"
      }
    ]
  },
  "librerias_activo": true,
  "librerias": {
    "requisitos": "requirements.txt",
    "dias_aviso": 10,
    "timeout": 7,
    "avisar_version_mayor": true,
    "ignorar": []
  },
  "eventos_chat_activo": true,
  "eventos_chat_bloquear": true,
  "eventos_chat_sin_red_bloquear": false,
  "eventos_chat_comandos": ["pip install", "pip3 install", "uv add", "uv pip install", "poetry add", "npm install", "npm i", "npm add", "yarn add", "pnpm add", "cargo add", "go get"],
  "pruebas_activo": true,
  "pruebas": {
    "carpeta": ".brain/pruebas"
  },
  "analisis_activo": false,
  "analisis": {
    "archivos": [
      "*.py"
    ],
    "tope_funcion_nueva": 150,
    "margen_crecimiento": 20,
    "margen_archivo_lineas": 300,
    "sql_excepciones": [],
    "reglas": [
      {
        "tipo": "llamada_con_timeout",
